# fp-tz topology — TradeZone fault proof.
# Copy and fill in real values before starting.

# ----- Required -----
L1_RPC=http://127.0.0.1:8545
L1_BEACON_RPC=http://127.0.0.1:3500

# TradeZone L2 endpoints (comma-separated)
L2_RPC=http://localhost:10000
L2_NODE_RPC=http://localhost:10000

# Contract addresses (deployed on L1)
FACTORY_ADDRESS={{FACTORY_ADDRESS}}
ANCHOR_STATE_REGISTRY_ADDRESS={{ANCHOR_STATE_REGISTRY_ADDRESS}}

# TZ game type
GAME_TYPE=1961
 
# ----- Mock mode (set true to skip real proving) -----
MOCK_MODE=true #ruanpc: change from false

# ----- Signer -----
PRIVATE_KEY={{PRIVATE_KEY}}

# XLayer remote signer (used instead of PRIVATE_KEY when XLAYER_SIGNER_ENABLED=true).
# The refOrderId prefix has no default: with the remote signer enabled, a missing
# or malformed value stops the process at startup. The challenger sets its own
# value so the two services' order IDs stay distinguishable.
# XLAYER_SIGNER_ENABLED=true
# XLAYER_SIGNER_ENDPOINT=
# XLAYER_SIGNER_ADDRESS=
# XLAYER_ACCESS_KEY=
# XLAYER_SECRET_KEY=
# XLAYER_SIGNER_REF_ORDER_PREFIX=PROPOSER_TZ_
# Socket address for the refOrderId lookup endpoint (GET /signer/get). Empty =
# disabled; a value that cannot be parsed, or cannot be bound, stops startup.
# The challenger serves the same endpoint and needs its own address.
# XLAYER_SIGNER_VERIFY_ADDR=127.0.0.1:9191

# ----- SP1 prover network -----
SP1_PROVER=network # cluster
NETWORK_PRIVATE_KEY=0x123456789abcdef123456789abcdef123456789abcdef123456789abcdef1234

# ----- Metrics -----
PROPOSER_METRICS_PORT=9000
CHALLENGER_METRICS_PORT=9001

# ----- Tuning -----
FETCH_INTERVAL=5 #ruanpc: change from 30
PROPOSAL_INTERVAL_IN_BLOCKS=100 # ruanpc: change from 600
SAFE_DB_FALLBACK=true
MAX_CONCURRENT_DEFENSE_TASKS=1

# Warn when the confirmed chain height seen by the proposer has not changed for this many
# seconds. The warning repeats on every later read while the height stays unchanged. Absent
# or unparseable falls back to 300; 0 disables the warning.
# TZ_CONFIRMED_HEIGHT_STAGNATION_THRESHOLD_SECS=300

CLI_CLUSTER_RPC=http://127.0.0.1:50051
CLI_REDIS_NODES=redis://:redispassword@127.0.0.1:6379/0

AGG_PROOF_MODE=plonk

TZ_LOCAL_EXECUTE=0

# Fulfillment strategy for range proofs (default: reserved)
RANGE_PROOF_STRATEGY=auction

# Fulfillment strategy for aggregation proofs (default: reserved)
AGG_PROOF_STRATEGY=auction

# Maximum price per PGU (default: 300000000, i.e., 0.3 PROVE per billion PGU)
MAX_PRICE_PER_PGU=500000000

# Minimum auction period in seconds (default: 1)
MIN_AUCTION_PERIOD=30

# Timeout for proving in seconds (default: 14400, i.e., 4 hours)
TIMEOUT=7200

# Cycle limit for range proofs (default: 1000000000000, i.e., 1 trillion)
RANGE_CYCLE_LIMIT=10000000000000

# Gas limit for range proofs (default: 1000000000000, i.e., 1 trillion)
RANGE_GAS_LIMIT=10000000000

# Number of splits to use for range proofs (default: 1, range: 1-16)
RANGE_SPLIT_COUNT=1

# Maximum number of concurrent range proof tasks (default: 1)
MAX_CONCURRENT_RANGE_PROOFS=1

# Cycle limit for aggregation proofs (default: 1000000000000, i.e., 1 trillion)
AGG_CYCLE_LIMIT=10000000000000

# Gas limit for aggregation proofs (default: 1000000000000, i.e., 1 trillion)
AGG_GAS_LIMIT=12000000