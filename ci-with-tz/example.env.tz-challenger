# fp-tz topology — TradeZone fault proof, challenger service.
#
# Template for `.env.tz-challenger`, the file `tz-challenger` loads by default.
#
# This is not a complete runnable configuration on its own. It shows the signer
# and lookup-endpoint settings on top of the normal challenger configuration
# (chain endpoints, dispute-game addresses, loop intervals); fill in the chain,
# contract and signer values for your deployment before using it.

# ----- Chain + dispute game -----
L1_RPC=http://127.0.0.1:8545
L2_RPC=http://localhost:10000

FACTORY_ADDRESS={{FACTORY_ADDRESS}}
ANCHOR_STATE_REGISTRY_ADDRESS={{ANCHOR_STATE_REGISTRY_ADDRESS}}

GAME_TYPE=1961

# ----- Signer -----
PRIVATE_KEY={{PRIVATE_KEY}}

# XLayer remote signer (used instead of PRIVATE_KEY when XLAYER_SIGNER_ENABLED=true).
# The proposer runs alongside the challenger, so the challenger needs its own
# order-ID prefix and its own lookup address: both services feed the same
# asset-management service, and their order IDs and callbacks must stay
# distinguishable. The prefix has no default — with the remote signer enabled a
# missing or malformed value stops the process at startup.
# XLAYER_SIGNER_ENABLED=true
# XLAYER_SIGNER_ENDPOINT=
# XLAYER_SIGNER_ADDRESS=
# XLAYER_ACCESS_KEY=
# XLAYER_SECRET_KEY=
# XLAYER_SIGNER_REF_ORDER_PREFIX=CHALLENGER_TZ_
# Socket address for the refOrderId lookup endpoint (GET /signer/get). Empty =
# disabled; a value that cannot be parsed, or cannot be bound, stops startup.
# A different address from the proposer's.
# XLAYER_SIGNER_VERIFY_ADDR=127.0.0.1:9292

# ----- Challenger loop -----
FETCH_INTERVAL=30
MALICIOUS_CHALLENGE_PERCENTAGE=0
CHALLENGER_METRICS_PORT=9001
TX_CONFIRMATION_TIMEOUT=60