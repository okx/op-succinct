#!/usr/bin/env bash
# Stub: cargo — simulates build by creating dummy binary
STUB_LOG="${STUB_LOG_DIR}/cargo.log"
echo "cargo $*" >> "${STUB_LOG}"
if [[ "$1" == "build" ]]; then
    # Parse --target and profile to determine output path
    PROFILE="release"
    TARGET=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --release) PROFILE="release"; shift ;;
            --debug) PROFILE="debug"; shift ;;
            --target) TARGET="$2"; shift 2 ;;
            --locked) shift ;;
            --features) shift 2 ;;
            --bin) shift 2 ;;
            --manifest-path) shift 2 ;;
            *) shift ;;
        esac
    done
    if [ -n "${TARGET}" ]; then
        mkdir -p "target/${TARGET}/${PROFILE}"
        echo "dummy-enclave-binary" > "target/${TARGET}/${PROFILE}/xlayer-tee-enclave"
    fi
elif [[ "$1" == "build" && "$*" == *"-p nitro-cli"* ]]; then
    mkdir -p target/release
    echo "dummy-nitro-cli" > target/release/nitro-cli
    chmod +x target/release/nitro-cli
fi
