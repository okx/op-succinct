#!/usr/bin/env bash
# Stub: rustup
STUB_LOG="${STUB_LOG_DIR}/rustup.log"
echo "rustup $*" >> "${STUB_LOG}"
if [[ "$1" == "target" && "$2" == "list" ]]; then
    if [ "${RUSTUP_MUSL_INSTALLED:-true}" = "true" ]; then
        echo "x86_64-unknown-linux-musl"
    fi
elif [[ "$1" == "target" && "$2" == "add" ]]; then
    : # no-op
fi
