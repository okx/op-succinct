FROM online-registry.cn-hongkong.cr.aliyuncs.com/inner-public/ubuntu/24.04/ubuntu:latest
USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 curl jq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY build/tz-proposer /usr/local/bin/tz-proposer

ENTRYPOINT ["tz-proposer"]
