# fp-full topology — full fault proof + monitoring.
# Copy and fill in real values before starting.

# ----- Required -----
L1_RPC=http://127.0.0.1:8545
L2_RPC=http://127.0.0.1:9545

# Contract addresses (deployed on L1)
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
ANCHOR_STATE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
GAME_TYPE=0

# ----- Proving (real proofs via SP1 network) -----
MOCK_MODE=false
# SP1_PROVER=network
# SP1_PRIVATE_KEY=<sp1-network-key>

# ----- Signer -----
# NETWORK_PRIVATE_KEY=<your-private-key>

# ----- Metrics -----
PROPOSER_METRICS_PORT=9000
CHALLENGER_METRICS_PORT=9001

# ----- Monitoring -----
FP_PROMETHEUS_PORT=9090
FP_GRAFANA_PORT=3000

# ----- Tuning -----
FETCH_INTERVAL=30
PROPOSAL_INTERVAL_IN_BLOCKS=1800
SAFE_DB_FALLBACK=false
MAX_CONCURRENT_DEFENSE_TASKS=8
TIMEOUT=14400
NETWORK_CALLS_TIMEOUT=15
RANGE_PROOF_STRATEGY=reserved
AGG_PROOF_STRATEGY=reserved
AGG_PROOF_MODE=plonk
